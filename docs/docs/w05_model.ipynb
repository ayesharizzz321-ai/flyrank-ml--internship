    "Model Variant": ["Week 4 Baseline", "Week 5 Capstone Model (Random Forest)"],
    "Accuracy": [0.6500, round(val_acc, 4)],
    "F1-Score": [0.6100, round(val_f1, 4)],
    "ROC-AUC": [0.6800, round(val_auc, 4) if isinstance(val_auc, float) else val_auc]
}

