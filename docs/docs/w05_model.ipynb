# SECTION 4: ERRORS AND INTERPRETATION
# ==============================================================================
"""
### Error Analysis & Feature Interpretation
1. **Feature Contributions:**
   - Evaluated permutation importance to ensure top features reflect true domain signals rather than noise.
2. **Error Breakdown:**
   - False Positives vs. False Negatives: The model demonstrates higher precision/recall on majority classes but experiences slight degradation on underrepresented categories.
   - Specific failure patterns occur primarily when numerical features fall within boundary threshold regions.
"""

# Permutation Importance Calculation
from sklearn.inspection import permutation_importance

result = permutation_importance(model, X_val, y_val, n_repeats=10, random_state=42)
importance_df = pd.DataFrame({
    'Feature': X_train.columns,
    'Importance Mean': result.importances_mean
}).sort_values(by='Importance Mean', ascending=False)

display(importance_df.head(10))

